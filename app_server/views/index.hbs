{{> header }}
<main>
  <section class="hero home-hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <div class="eyebrow light">COLLECT EXPERIENCES, NOT THINGS</div>
        <h1>Find your next <em>great escape.</em></h1>
        <p>From hidden coastlines to once-in-a-lifetime adventures, the world has a place waiting for you.</p>
        <div class="actions"><a class="button button-primary" href="/travel">Explore destinations <span aria-hidden="true">↗</span></a><a class="button button-ghost" href="/about">Meet Travlr</a></div>
      </div>
      <img class="hero-illustration" src="/images/hero.svg" alt="Illustration of a beautiful coast with green hills and sailboat">
    </div>
    <div class="hero-bottom shell"><span class="sparkle" aria-hidden="true">✦</span> Thoughtful travel, unforgettable experiences.</div>
  </section>
  <section class="section shell">
    <div class="section-heading"><div><span class="eyebrow">THE WORLD IS OPEN</span><h2>Choose your kind of wonderful.</h2></div><a class="text-link" href="/travel">View every trip <span aria-hidden="true">→</span></a></div>
    <div class="trip-grid">
      <a class="trip-card" href="/travel#bali"><img src="/images/bali.svg" alt="Tropical island scenery"><span class="card-body"><span class="card-kicker">ISLAND ESCAPE</span><strong>Bali, Indonesia</strong><span>Warm sand, lush green hills and coastal adventures.</span></span></a>
      <a class="trip-card" href="/travel#santorini"><img src="/images/santorini.svg" alt="White buildings above a blue sea"><span class="card-body"><span class="card-kicker">COASTAL RETREAT</span><strong>Santorini, Greece</strong><span>Sunsets, winding village paths and sparkling water.</span></span></a>
      <a class="trip-card" href="/travel#costa-rica"><img src="/images/costa-rica.svg" alt="Green mountains and rainforest"><span class="card-body"><span class="card-kicker">WILD ADVENTURE</span><strong>Costa Rica</strong><span>Rainforest views, wildlife and memorable outdoor days.</span></span></a>
    </div>
  </section>
  <section class="banner"><div class="shell banner-inner"><div><span class="eyebrow light">YOUR NEXT STORY STARTS HERE</span><h2>Ready to get going?</h2><p>Browse our handpicked travel ideas and start planning your next trip.</p></div><a class="button button-cream" href="/travel">See travel packages <span aria-hidden="true">→</span></a></div></section>
</main>
{{> footer }}
