{{> header }}
<main>
  <section class="page-banner">
    <div class="shell">
      <span class="eyebrow light">DISCOVER THE WORLD WITH US</span>
      <h1>Travel packages</h1>
      <p>Explore destinations and find inspiration for your next trip.</p>
    </div>
  </section>

  <section class="section shell">
    <div class="section-heading compact">
      <div>
        <span class="eyebrow">FEATURED DESTINATIONS</span>
        <h2>Explore somewhere new.</h2>
        <p class="section-desc">Take a look at a few popular places to visit.</p>
      </div>
    </div>

    <div class="travel-list">
      <article class="travel-item" id="bali">
        <img src="/images/bali.svg" alt="Green hills and turquoise ocean in Bali">
        <div class="travel-content">
          <div class="meta">INDONESIA · ISLAND GETAWAY</div>
          <h3>Bali Island Escape</h3>
          <p>Relax on beautiful beaches, explore tropical landscapes, and experience the local culture.</p>
          <div class="tag-row"><span>Beaches</span><span>Nature</span><span>Culture</span></div>
          <a class="text-link" href="/contact">Learn more <span aria-hidden="true">→</span></a>
        </div>
      </article>

      <article class="travel-item" id="santorini">
        <img src="/images/santorini.svg" alt="Whitewashed coastal village above the sea in Greece">
        <div class="travel-content">
          <div class="meta">GREECE · COASTAL RETREAT</div>
          <h3>Santorini Coastline</h3>
          <p>Walk through seaside villages and enjoy the ocean views and sunsets Santorini is known for.</p>
          <div class="tag-row"><span>Ocean views</span><span>Villages</span><span>Relaxation</span></div>
          <a class="text-link" href="/contact">Learn more <span aria-hidden="true">→</span></a>
        </div>
      </article>

      <article class="travel-item" id="costa-rica">
        <img src="/images/costa-rica.svg" alt="Rainforest and mountains in Costa Rica">
        <div class="travel-content">
          <div class="meta">COSTA RICA · ADVENTURE</div>
          <h3>Costa Rica Discovery</h3>
          <p>Visit lush rainforests, discover local wildlife, and enjoy outdoor adventures in Costa Rica.</p>
          <div class="tag-row"><span>Rainforest</span><span>Wildlife</span><span>Adventure</span></div>
          <a class="text-link" href="/contact">Learn more <span aria-hidden="true">→</span></a>
        </div>
      </article>
    </div>
  </section>
</main>
{{> footer }}
